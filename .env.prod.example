# ========================================================
# Production Environment Configuration (.env.prod)
# ========================================================

# Deployment Environment (triggers Production Safe Mode)
ENVIRONMENT=production
PROJECT_NAME="Autonomous AI QA Testing Agent"

# Production PostgreSQL Database
DATABASE_URL=postgresql://qa_admin:ChangeThisSuperSecurePassword123!@postgres:5432/qa_prod
POSTGRES_USER=qa_admin
POSTGRES_PASSWORD=ChangeThisSuperSecurePassword123!
POSTGRES_DB=qa_prod

# AI / LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-production-api-key
OPENAI_MODEL=gpt-4o

# Browser Automation (Hardened Headless)
DEFAULT_BROWSER=chromium
HEADLESS=true
BROWSER_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000

# Safety Policy & Strict Guardrails
# In production, destructive actions (delete, drop, purchase, etc.) are strictly blocked 
# or require explicit human approval via WebSockets before execution.
CONFIDENCE_THRESHOLD=0.85
MAX_RETRIES=1
MAX_AGENT_STEPS=150

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["https://qa.yourdomain.com"]
