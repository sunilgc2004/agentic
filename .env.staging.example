# ========================================================
# Staging Environment Configuration (.env.staging)
# ========================================================

# Deployment Environment
ENVIRONMENT=staging
PROJECT_NAME="Autonomous AI QA Testing Agent (Staging)"

# Staging Database (SQLite volume or Staging PostgreSQL)
DATABASE_URL=sqlite:///./data/qa_agent_staging.db
# DATABASE_URL=postgresql://qa_stage:StagePass123!@postgres_stage:5432/qa_agent_staging

# AI / LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-staging-api-key
OPENAI_MODEL=gpt-4o

# Browser Automation
DEFAULT_BROWSER=chromium
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000

# Safety & Execution Rules
CONFIDENCE_THRESHOLD=0.70
MAX_RETRIES=2
MAX_AGENT_STEPS=100

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["https://stage-qa.yourdomain.com","http://localhost:5173","http://localhost:8000"]
