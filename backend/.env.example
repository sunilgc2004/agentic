# AI Autonomous QA Testing Agent Configuration

# LLM Configuration (options: heuristic, openai, ollama)
LLM_PROVIDER=heuristic

# OpenAI Configuration (optional if using OpenAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Ollama Configuration (optional if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database URL (SQLite default, PostgreSQL ready: postgresql://user:pass@localhost:5432/qa_agent)
DATABASE_URL=sqlite:///./data/qa_agent.db

# Browser Automation
DEFAULT_BROWSER=chromium
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000

# Agent Safety & Retries
MAX_RETRIES=2
MAX_AGENT_STEPS=100
CONFIDENCE_THRESHOLD=0.70
